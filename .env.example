# PageLens Environment Configuration Example
# Copy this file to .env and adjust as needed

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Redis & Cache Configuration
# Set USE_FAKEREDIS=true to run without a live Redis server
REDIS_URL=redis://redis:6379/0
USE_FAKEREDIS=false
REDIS_CACHE_TTL_SECONDS=86400

# Security & Scraping Limits
RATE_LIMIT_PER_MINUTE=10
MAX_RESPONSE_SIZE_BYTES=5242880
MAX_TOTAL_ANALYSIS_BYTES=20971520
DEFAULT_TIMEOUT_SECONDS=15
HARD_TIMEOUT_SECONDS=30
MAX_REDIRECTS=5
USER_AGENT=PageLensBot/1.0 (+https://pagelens.dev/bot)

# Frontend Build & Dev Variables
VITE_API_BASE_URL=http://localhost:8000
